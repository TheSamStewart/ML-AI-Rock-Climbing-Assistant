.venv/
.uv/
__pycache__/
*.pyc
.DS_Store
node_modules
expo-env.d.ts
.expo/
.vscode/
personal_docs/

# Secrets - docker-compose reads .env from the project root automatically;
# never commit real keys.
.env
.env.*
!.env.example

# Model weights: too large/binary for git, drop them in locally per
# backend/models/README.md.
backend/models/*
!backend/models/README.md

# pytest-cov output - regenerated on every run, CI uploads its own as an artifact.
.coverage
.coverage.*
coverage.xml
htmlcov/

# Synthetic volume-test scenes (regenerate with `uv run python -m accuracy_checks.fakewall` from backend/)
backend/fakewall_out/

# Volume scan test feature: every scan's photos and result (~10 MB each),
# written by POST /dev/volume-scan (docs/milestones/v0.2/38-volume-scan-trial/spec.md).
backend/field_captures_scans/
