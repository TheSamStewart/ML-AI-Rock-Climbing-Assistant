{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run python -m pytest *)",
      "Bash(uv run python -m accuracy_checks.eval_field *)",
      "Bash(uv run python -m accuracy_checks.eval_scale *)",
      "Bash(uv run python -m accuracy_checks.eval_angle *)",
      "Bash(uv run python -m accuracy_checks.eval_volume *)",
      "Bash(uv run python -m accuracy_checks.eval_volume_field *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npm run lint *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * *:main)",
      "Bash(git push * *:main *)",
      "Bash(git push * *:refs/heads/main)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/branch_guard.mjs"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/branch_guard.mjs", "session"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
