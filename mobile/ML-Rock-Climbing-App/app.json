{
  "expo": {
    "scheme": "climbgoat",
    "name": "ClimbGoat",
    "slug": "ClimbGoat",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.yourname.climbgoat"
    },
    "android": {
      "package": "com.yourname.climbgoat",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ClimbGoat uses your camera to photograph routes and problems.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
